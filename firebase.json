{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "hosting": {
    "site": "notepade",
    "public": "dist",
    "redirects": [
      {
        "source": "/:path*",
        "destination": "https://nopedat.web.app/:path*",
        "type": 301
      }
    ],
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"]
  }
}
